{
  "uid": "otlp-collector-oidc",
  "title": "otlp-collector-oidc",
  "description": "The collector's own metrics, as scraped from :8888. Shipped by github.com/vcheesbrough/otlp-collector-oidc; the runbook is docs/runbook.md.",
  "tags": [
    "otlp-collector-oidc",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/vcheesbrough/otlp-collector-oidc/blob/main/docs/runbook.md",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(target_info, service_name)",
          "refId": "service"
        },
        "definition": "label_values(target_info, service_name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "otlp-collector-oidc",
          "value": "otlp-collector-oidc"
        }
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(target_info{service_name=~\"$service\"}, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(target_info{service_name=~\"$service\"}, deployment_environment_name)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is it healthy?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Accepted from clients",
      "description": "Items the receiver accepted, per second, by signal and transport.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport) (rate(otelcol_receiver_accepted_spans[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "spans {{transport}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport) (rate(otelcol_receiver_accepted_log_records[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "log records {{transport}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Refused by the authenticator",
      "description": "Requests refused for their token, by reason. not_ready: the provider's keys have not loaded; missing_claim: the provider stopped emitting a required claim.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(otelcol_oidcclientauth_rejections[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Exported upstream",
      "description": "Items sent upstream, per second, by exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_spans[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "spans {{exporter}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate(otelcol_exporter_sent_log_records[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "log records {{exporter}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Upstream",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Given up after retries",
      "description": "Items dropped after UPSTREAM_RETRY_MAX_ELAPSED of failed attempts, by exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_spans[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "spans {{exporter}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate(otelcol_exporter_send_failed_log_records[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "log records {{exporter}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dropped, queue full",
      "description": "Items refused because the sending queue (UPSTREAM_QUEUE_SIZE) was full, by exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate(otelcol_exporter_enqueue_failed_spans[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "spans {{exporter}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (exporter) (rate(otelcol_exporter_enqueue_failed_log_records[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "log records {{exporter}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue fill",
      "description": "Sending queue size as a fraction of its capacity, by exporter and pipeline. Near 1 while the upstream is down; drops follow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (exporter, data_type) (otelcol_exporter_queue_size * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"}) / max by (exporter, data_type) (otelcol_exporter_queue_capacity * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "{{exporter}} {{data_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Refusals before the pipeline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Refused by the receiver",
      "description": "Requests refused before authentication or the pipeline, by transport and reason (method, media_type, body_too_large, decode, unknown_path, decompress).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport, reason) (rate(otelcol_otlpsingleport_requests_refused[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "{{transport}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Refused by the pipeline",
      "description": "Items the pipeline refused back to the client (memory_limiter back-pressure, an upstream answer passed through), by transport.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport) (rate(otelcol_receiver_refused_spans[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "spans {{transport}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport) (rate(otelcol_receiver_refused_log_records[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "log records {{transport}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport) (rate(otelcol_receiver_failed_spans[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "failed spans {{transport}}",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (transport) (rate(otelcol_receiver_failed_log_records[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "failed log records {{transport}}",
          "refId": "D"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Process",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory",
      "description": "Resident memory against MEMORY_LIMIT_MIB, which memory_limiter enforces, and the Go heap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (otelcol_process_memory_rss * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "rss {{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (otelcol_process_runtime_heap_alloc_bytes * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "heap {{instance}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU seconds per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (rate(otelcol_process_cpu_seconds[$__rate_interval]) * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Uptime",
      "description": "Seconds since start; a drop to zero is a restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (instance) (otelcol_process_uptime * on (job, instance) group_left() target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 16,
      "type": "table",
      "title": "Build",
      "description": "One row per running process: its version and instance, from target_info.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (deployment_environment_name, service_version, service_instance_id, instance) (target_info{deployment_environment_name=~\"$env\", service_name=~\"$service\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ]
    }
  ]
}
