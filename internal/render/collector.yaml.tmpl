{{- /*
The shipped pipeline. `otlp-collector-oidc run` renders it from the
environment (internal/render); every value below comes from a variable in
docs/configuration.md. Strings pass through `q`, which quotes them and escapes
"$", so no value can inject YAML or a ${...} reference.

Every request is authenticated by oidcclientauth before it is dispatched.
Traces and logs: otlpsingleport → memory_limiter → batch → the signal's
exporter: otlp_grpc or otlp_http, one per distinct upstream configuration
(internal/upstream), so signals with the same upstream share one. Metrics have
no pipeline yet, so their upstream is not resolved and the receiver answers
404 / Unimplemented for them until the bounded metrics pipeline lands.
*/ -}}
# Rendered by otlp-collector-oidc run from the environment.
# The variables are documented in docs/configuration.md.

receivers:
  otlpsingleport:
    endpoint: {{ q .Listener.ListenAddr }}
    max_request_body_size: {{ .Listener.MaxRequestBodyBytes }}
    tls:
      cert_file: {{ q .Listener.TLSCertFile }}
      key_file: {{ q .Listener.TLSKeyFile }}
      reload_interval: {{ q .Listener.TLSReloadInterval }}
{{- with .Listener.CORSAllowedOrigins }}
    cors:
      allowed_origins: {{ list . }}
      # What an OTLP/HTTP export from a browser sends. rs/cors allows
      # Content-Type implicitly only when this list is empty, so it is listed.
      allowed_headers: ["Authorization", "Content-Type", "Content-Encoding"]
{{- end }}
    auth:
      authenticator: oidcclientauth

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: {{ .Resources.MemoryLimitMiB }}
    spike_limit_mib: {{ .Resources.MemorySpikeLimitMiB }}
  batch:
    timeout: {{ q .Resources.BatchTimeout }}

exporters:
{{- range .Upstream.Exporters }}
  {{ .ID }}:
{{- range .Endpoints }}
    {{ .Key }}: {{ q .Value }}
{{- end }}
    tls:
      insecure: {{ .Config.Plaintext }}
{{- if not .Config.Plaintext }}
      insecure_skip_verify: {{ .Config.SkipVerify }}
{{- with .Config.CAFile }}
      ca_file: {{ q . }}
{{- end }}
{{- with .Config.ClientCertFile }}
      cert_file: {{ q . }}
{{- end }}
{{- with .Config.ClientKeyFile }}
      key_file: {{ q . }}
{{- end }}
{{- end }}
{{- with .Headers }}
    headers:
{{- range . }}
      - name: {{ q .Name }}
        value: {{ q .Value }}
{{- end }}
{{- end }}
    timeout: {{ q .Config.Timeout }}
    compression: {{ q .Config.Compression }}
    sending_queue:
      queue_size: {{ .Config.QueueSize }}
    retry_on_failure:
      enabled: true
      initial_interval: {{ q .Config.RetryInitialInterval }}
      max_elapsed_time: {{ q .Config.RetryMaxElapsed }}
      max_interval: {{ q .Config.RetryMaxInterval }}
{{- end }}

extensions:
  health_check:
    endpoint: {{ q .Self.HealthAddr }}
  oidcclientauth:
    issuer_url: {{ q .Identity.IssuerURL }}
    audience: {{ q .Identity.Audience }}
    discovery_retry: {{ q .Identity.DiscoveryRetry }}
    jwks_refresh: {{ q .Identity.JWKSRefresh }}
    required_scope: {{ q .Identity.RequiredScope }}
    required_claims: {{ list .Identity.RequiredClaims }}
    clock_skew: {{ q .Identity.ClockSkew }}
    rejection_log_interval: {{ q .Identity.RejectionLogInterval }}

service:
  extensions: [health_check, oidcclientauth]
  telemetry:
    # The process's own identity, on its logs and on target_info at :8888.
    # service.version is the build's, which the collector adds itself.
    resource:
      "service.name": {{ q .Own.ServiceName }}
{{- with .InstanceID }}
      "service.instance.id": {{ q . }}
{{- end }}
{{- range .Own.ResourceAttributes.Without "service.name" "service.version" }}
      {{ q .Key }}: {{ q .Value }}
{{- end }}
    logs:
      level: {{ q .Logs.Level }}
      encoding: {{ q .Logs.Format }}
      output_paths: [{{ if .Own.Output.Stdout }}"stdout"{{ end }}]
      error_output_paths: ["stderr"]
{{- with .SelfLogProcessors }}
      # Own logs to the logs upstream (LOG_OUTPUT), as the SDK's schema has it.
      processors: {{ . }}
{{- end }}
    metrics:
      readers:
        - pull:
            exporter:
              prometheus:
                host: {{ q .Self.SelfMetricsAddr.Host }}
                port: {{ .Self.SelfMetricsAddr.Port }}
  pipelines:
    traces:
      receivers: [otlpsingleport]
      processors: [memory_limiter, batch]
      exporters: [{{ .Upstream.ExporterFor "traces" }}]
    logs:
      receivers: [otlpsingleport]
      processors: [memory_limiter, batch]
      exporters: [{{ .Upstream.ExporterFor "logs" }}]
